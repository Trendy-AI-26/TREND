# Copy to .env.local and adjust.

# --- Auth -------------------------------------------------------------------
# Secret used to verify the `trendy_session` JWT (HS256) in middleware and server
# components. Server-only: never prefix with NEXT_PUBLIC_. MUST be identical to
# the backend's AUTH_JWT_SECRET.
AUTH_JWT_SECRET=change-me-to-a-long-random-string-of-32+chars

# --- Backend ----------------------------------------------------------------
# Server-side URL of the FastAPI backend. Used by the `/api/*` rewrite in
# next.config.mjs, the route handlers and server components.
NEXT_SERVER_API_URL=http://127.0.0.1:8000

# Optional. Browser-side API base. Defaults to `/api` (same origin, proxied to
# NEXT_SERVER_API_URL by the rewrite, so the session cookie stays first-party).
# NEXT_PUBLIC_API_URL=/api

# --- Images -----------------------------------------------------------------
# Public base URL of the MinIO/S3 host that serves generated images and logos.
# The backend returns URLs like {base}/{bucket}/{path}. Used for the
# next/image remotePatterns allow-list (baked in at build time).
NEXT_PUBLIC_STORAGE_PUBLIC_URL=https://s3.example.com
