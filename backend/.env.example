# Supabase Configuration
# Local:  http://127.0.0.1:54321 (via `supabase start`)
# Hosted: https://<project-ref>.supabase.co (from dashboard → Settings → API)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=your-secret-key-here

# Storage Configuration
STORAGE_BUCKET=brand-assets

# Admin Configuration
ADMIN_EMAILS=admin@example.com

# CORS Configuration
# Comma-separated list of allowed origins (must match the host:port you expose)
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost

# Server Configuration (local dev only; Docker uses BACKEND_HOST/BACKEND_PORT)
HOST=127.0.0.1
PORT=8000

# Sprint 4 Managed Generation
# These values are server-side only.
# Never expose them to the frontend.

MANAGED_GENERATION_ENABLED=false

MANAGED_IMAGE_PROVIDER=openai
MANAGED_IMAGE_MODEL=replace-with-approved-image-model
MANAGED_IMAGE_API_KEY=server-side-secret

MANAGED_TEXT_PROVIDER=openai
MANAGED_TEXT_MODEL=replace-with-approved-text-model
MANAGED_TEXT_API_KEY=server-side-secret

