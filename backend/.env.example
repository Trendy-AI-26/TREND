SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-me

STORAGE_BUCKET=brand-assets
PRODUCT_ASSETS_BUCKET=product-assets
AVATARS_BUCKET=avatars

# Managed generation is configured server-side only.
IMAGE_PROVIDER=openai
TEXT_PROVIDER=openai
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_API_KEY=replace-with-your-openai-key

GENERATION_CREDIT_COST=1
GENERATION_RATE_LIMIT=5
GENERATION_RATE_WINDOW_SECONDS=60
GENERATION_LOCK_TTL_SECONDS=180
