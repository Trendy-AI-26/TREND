# Supabase Configuration
# Local:  http://127.0.0.1:54321 (via `supabase start`)
# Hosted: https://<project-ref>.supabase.co (from dashboard → Settings → API)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=your-secret-key-here

# Storage Configuration
STORAGE_BUCKET=brand-assets

# Admin Configuration
ADMIN_EMAILS=admin@example.com

# CORS Configuration
# Comma-separated list of allowed origins (must match the host:port you expose)
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost

# Server Configuration (local dev only; Docker uses BACKEND_HOST/BACKEND_PORT)
HOST=127.0.0.1
PORT=8000

# Image Generation (server-side only)
# provider, model, and API key for image + caption generation.
# These are the ONLY source of credentials: they are never read from a
# request body. GenerateRequest sets "extra": "forbid", so a client that
# tries to send api_key / provider / model is rejected with a 422.
GENERATION_PROVIDER=openai
GENERATION_MODEL=gpt-image-2
GENERATION_API_KEY=replace-with-your-openai-key

