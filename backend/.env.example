SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-me

STORAGE_BUCKET=brand-assets
PRODUCT_ASSETS_BUCKET=product-assets
AVATARS_BUCKET=avatars

# Admin Configuration
ADMIN_EMAILS=admin@example.com

# CORS Configuration
# Comma-separated list of allowed origins (must match the host:port you expose)
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost

# Server Configuration (local dev only; Docker uses BACKEND_HOST/BACKEND_PORT)
HOST=127.0.0.1
PORT=8000

# Managed generation is configured server-side only.
# A single key serves both images and captions; models are chosen per feature.
IMAGE_PROVIDER=openai
TEXT_PROVIDER=openai
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_API_KEY=replace-with-your-openai-key

# Credits, rate limiting, and duplicate-submission guard
GENERATION_CREDIT_COST=1
GENERATION_RATE_LIMIT=5
GENERATION_RATE_WINDOW_SECONDS=60
GENERATION_LOCK_TTL_SECONDS=180
