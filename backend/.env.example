# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# "production" makes a missing AUTH_JWT_SECRET a startup error.
APP_ENV=development

# ---------------------------------------------------------------------------
# Database (plain PostgreSQL, psycopg v3 driver)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://trendy:change-me@localhost:5432/trendy
# Apply backend/db/migrations/*.sql when the API starts (safe with several
# replicas: the runner takes a Postgres advisory lock). You can also run
# `python -m app.db.migrate` yourself.
RUN_MIGRATIONS_ON_STARTUP=false

# ---------------------------------------------------------------------------
# Object storage (S3-compatible, e.g. MinIO)
# ---------------------------------------------------------------------------
# Internal address the backend uses to reach the storage.
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
# Browser-facing base URL. Public image URLs are {S3_PUBLIC_BASE_URL}/{bucket}/{path}.
# The brand-assets bucket must allow anonymous read; avatars/product-assets are
# served through time-limited signed URLs and can stay private.
S3_PUBLIC_BASE_URL=http://localhost:9000

STORAGE_BUCKET=brand-assets
PRODUCT_ASSETS_BUCKET=product-assets
AVATARS_BUCKET=avatars

# ---------------------------------------------------------------------------
# Authentication (owned by the backend)
# ---------------------------------------------------------------------------
# Secret for HS256 session/reset JWTs and code hashing. Use 32+ random bytes,
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
AUTH_JWT_SECRET=replace-with-a-long-random-string
# Session lifetime (cookie Max-Age and JWT exp), seconds. Default: 7 days.
AUTH_SESSION_TTL_SECONDS=604800
# Set true behind HTTPS so the trendy_session cookie gets the Secure flag.
AUTH_COOKIE_SECURE=false
# true  = sign-up and login require the emailed 6-digit code (default).
# false = instant sign-up/login with no email and no code; use it only until
#         SMTP works, then set it back to true (unverified users are then asked
#         to verify on their next login).
AUTH_REQUIRE_EMAIL_VERIFICATION=true
# Fernet key that encrypts provider API keys (BYOK) at rest. Generate with
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`.
APP_ENCRYPTION_KEY=replace-with-a-fernet-key

# Comma-separated admin emails (compared case-insensitively).
ADMIN_EMAILS=admin@example.com

# ---------------------------------------------------------------------------
# Email (SMTP) for verification and password-reset codes
# ---------------------------------------------------------------------------
# Leave SMTP_HOST empty in development: codes are then logged at WARNING level
# instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=TRENDY AI <no-reply@example.com>
SMTP_STARTTLS=true

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated list of allowed origins (must match the host:port you expose)
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost

# Server Configuration (local dev only; Docker uses BACKEND_HOST/BACKEND_PORT)
HOST=127.0.0.1
PORT=8000

# ---------------------------------------------------------------------------
# Generation
# ---------------------------------------------------------------------------
# Generation is configured server-side only. These are the Render variable
# names; GENERATION_MODEL is image-specific, while the shared key serves both
# image and caption generation. Legacy IMAGE_/OPENAI_* names remain fallbacks.
GENERATION_PROVIDER=openai
GENERATION_MODEL=gpt-image-2
GENERATION_API_KEY=replace-with-your-openai-key
TEXT_PROVIDER=openai
OPENAI_TEXT_MODEL=gpt-4o-mini

# Credits, rate limiting, and duplicate-submission guard
GENERATION_CREDIT_COST=1
GENERATION_RATE_LIMIT=5
GENERATION_RATE_WINDOW_SECONDS=60
GENERATION_LOCK_TTL_SECONDS=180
